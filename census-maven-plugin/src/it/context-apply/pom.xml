<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>it.cryptocensus</groupId>
    <artifactId>context-apply</artifactId>
    <version>1.0</version>
    <description>Happy path; an inherited argLine carrying a secret must not be logged</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <census.contextFile>${project.basedir}/private/context.json</census.contextFile>
        <census.changesFile>${project.build.directory}/proposal.json</census.changesFile>
    </properties>

    <dependencies>
        <dependency><groupId>@project.groupId@</groupId><artifactId>census-assessment</artifactId><version>@project.version@</version><scope>test</scope></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>@junit.version@</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <groupId>@project.groupId@</groupId>
                <artifactId>@project.artifactId@</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution><id>apply</id><phase>verify</phase><goals><goal>context-apply</goal></goals></execution>
                    <execution><id>repeat</id><phase>verify</phase><goals><goal>context-apply</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
