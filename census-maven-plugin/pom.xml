<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.developmentsprint</groupId>
        <artifactId>census-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>census-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Crypto Census :: Maven Plugin</name>
    <description>
        prepare-agent attaches the agent to test JVMs; check merges their CBOMs and enforces a risk threshold.
    </description>

    <properties>
        <!-- Set by JaCoCo's prepare-agent-integration in the quality profile; empty otherwise. -->
        <invoker.mavenOpts/>
        <invoker.groovy.version>4.0.33</invoker.groovy.version>
    </properties>

    <prerequisites>
        <maven>3.6.3</maven>
    </prerequisites>

    <dependencies>
        <dependency>
            <groupId>com.developmentsprint</groupId>
            <artifactId>census-core</artifactId>
        </dependency>
        <dependency>
            <!-- Not used on the plugin classpath; resolved so prepare-agent can point -javaagent at it. -->
            <groupId>com.developmentsprint</groupId>
            <artifactId>census-agent</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>census</goalPrefix>
                </configuration>
            </plugin>
            <plugin>
                <!-- Real Maven builds against src/it/* projects: argLine composition, failure modes, odd paths -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.10.1</version>
                <dependencies>
                    <!--
                        verify.groovy hooks: the Groovy 4.0.31 that Invoker 3.10.1 ships embeds an ASM that
                        cannot read Java 27 class files ("Unsupported class file major version 71"), so every
                        post-build hook failed on JDK 27. 4.0.33 is the first 4.x with ASM support for V27.
                    -->
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>${invoker.groovy.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy-json</artifactId>
                        <version>${invoker.groovy.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy-xml</artifactId>
                        <version>${invoker.groovy.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <postBuildHookScript>verify</postBuildHookScript>
                    <goals>
                        <goal>verify</goal>
                    </goals>
                    <showErrors>true</showErrors>
                    <!-- carries the JaCoCo agent into the Invoker builds when the quality profile is on -->
                    <mavenOpts>${invoker.mavenOpts}</mavenOpts>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Coverage that counts the Invoker builds: the plugin runs inside separate Maven processes there,
            so instrument those (MAVEN_OPTS) and merge with the unit-test data before checking.
        -->
        <profile>
            <id>quality</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <properties>
                <jacoco.minimum.line>0.80</jacoco.minimum.line>
                <jacoco.minimum.branch>0.60</jacoco.minimum.branch>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-invoker</id>
                                <goals>
                                    <goal>prepare-agent-integration</goal>
                                </goals>
                                <configuration>
                                    <propertyName>invoker.mavenOpts</propertyName>
                                    <includes>
                                        <include>com.developmentsprint.cryptocensus.*</include>
                                    </includes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-merge</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>merge</goal>
                                </goals>
                                <configuration>
                                    <fileSets>
                                        <fileSet>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>jacoco.exec</include>
                                                <include>jacoco-it.exec</include>
                                            </includes>
                                        </fileSet>
                                    </fileSets>
                                    <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-check</id>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
