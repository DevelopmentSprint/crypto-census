#!/usr/bin/env bash
# Check every outgoing ref; only a verified documentation-only push can skip Maven.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
refs=$(mktemp "${TMPDIR:-/tmp}/census-push-refs.XXXXXX")
trap 'rm -f "$refs"' EXIT
cat > "$refs"

# Both checks need the complete input; never consume it only in the first guard.
bash scripts/check-private-tracker.sh --pre-push "${1:-}" < "$refs"
mode=$(python3 scripts/ci_changes.py pre-push "${1:-}" < "$refs")
if [ "$mode" = docs-only ]; then
  echo "pre-push: documentation-only outgoing history; validating the documentation site..."
  npm ci
  npm audit --audit-level=moderate
  node --test scripts/docs/*_test.mjs
  python3 -m unittest discover -s scripts/docs -p '*_test.py'
  python3 scripts/coverage_badges_test.py
  npm run docs:typecheck
  npm run docs:build
  # Browser coverage remains required in the hosted Documentation check.
else
  echo "pre-push: full build with tests and coverage..."
  ./mvnw -B -q verify
fi
echo "pre-push: checks passed."
