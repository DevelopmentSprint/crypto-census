<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.developmentsprint</groupId>
        <artifactId>census-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>census-agent</artifactId>
    <name>Crypto Census :: Agent</name>
    <description>
        The -javaagent. Observes JCA/JSSE usage at runtime and writes a CycloneDX CBOM on exit.
        Ships as a single self-contained jar; Byte Buddy is shaded and relocated.
    </description>

    <properties>
        <!--
            Unit-test coverage floors, measured on target/classes for the classes designed to be unit
            tested: Installer (it instruments the JVM it runs in) and Advices (inlined into JDK
            methods, never run as their own classes) are excluded from this gate and owned by the
            runtime gate below (jacoco.runtime.minimum.*), which measures the agent in child JVMs.
            Measured 91.8% line / 82.6% branch on JDK 25. Raise when coverage rises, never lower.
        -->
        <jacoco.minimum.line>0.90</jacoco.minimum.line>
        <jacoco.minimum.branch>0.80</jacoco.minimum.branch>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.developmentsprint</groupId>
            <artifactId>census-core</artifactId>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- TomcatIT: embedded HTTPS server in a child JVM with the agent -->
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>${tomcat.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
                            <relocations>
                                <relocation>
                                    <pattern>net.bytebuddy</pattern>
                                    <shadedPattern>com.developmentsprint.cryptocensus.agent.shaded.bytebuddy</shadedPattern>
                                </relocation>
                                <relocation>
                                    <!-- the agent's private copy of core must not shadow an application's census-core -->
                                    <pattern>com.developmentsprint.cryptocensus.core</pattern>
                                    <shadedPattern>com.developmentsprint.cryptocensus.agent.shaded.core</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <!-- multi-release extras are not relocated by shade, and our manifest is not Multi-Release -->
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>com.developmentsprint.cryptocensus.agent.CensusAgent</Premain-Class>
                                        <Agent-Class>com.developmentsprint.cryptocensus.agent.CensusAgent</Agent-Class>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Implementation-Title>Crypto Census Agent</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- ApmCoexistenceIT / TomcatIT: the OpenTelemetry Java agent, as a file (never on a class path) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-apm-agent</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.opentelemetry.javaagent</groupId>
                                    <artifactId>opentelemetry-javaagent</artifactId>
                                    <version>${opentelemetry-javaagent.version}</version>
                                    <destFileName>opentelemetry-javaagent.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/it-agents</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <census.agent.jar>${project.build.directory}/${project.build.finalName}.jar</census.agent.jar>
                        <otel.agent.jar>${project.build.directory}/it-agents/opentelemetry-javaagent.jar</otel.agent.jar>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Coverage of the agent as it really runs (quality profile, JDK 21+ only, like the parent's).

            AgentIT runs the packaged agent in child JVMs, where it is loaded from the shaded jar by
            the bootstrap class loader. Relocation rewrites those classes, so they are not the bytes
            in target/classes and the parent's unit-test report cannot see that execution at all.
            Here instead:
              1. prepare-agent-integration builds a JaCoCo -javaagent string for the child JVMs
                 (bootstrap classes included, only the agent's own classes, not the shaded copies of
                 Byte Buddy and census-core) into ${census.it.jacocoAgent}; Failsafe hands it to
                 AgentIT as a system property, and ChildJvmCoverage puts it on each child command
                 line. The children write target/jacoco-it.exec (deleted before each IT run, since the
                 JaCoCo agent appends). JaCoCo dumps from a shutdown hook that races the census
                 agent's own CBOM-writing hook, so the child workloads (CryptoWorkload, TomcatWorkload)
                 dump once more after that hook. ChildJvm adds the JaCoCo agent to every child.
              2. At verify, src/build/runtime-coverage.xml (JaCoCo's Ant report task; the Maven
                 plugin can only analyze target/classes) analyzes the agent classes *inside the
                 shaded jar*: byte for byte what the children loaded, and every class, executed or
                 not. Execution data: jacoco-it.exec plus the unit tests' jacoco.exec. Unit-test data
                 counts only for classes the shade left byte-identical (KeyInfo, CensusAgent); for
                 the rest JaCoCo ignores it, so the result never overstates coverage. The Advices
                 bodies are inlined into JDK methods and never run as their own classes, so they
                 always show as uncovered.
              3. The check fails the build below jacoco.runtime.minimum.*; the report is in
                 target/site/jacoco-runtime. The parent's unit-test gate (jacoco.minimum.*) still
                 applies on its own. Without test runs (-DskipTests, -DskipITs, -Djacoco.skip) the
                 runtime gate is skipped; with tests it fails if no child-JVM data was written.
        -->
        <profile>
            <id>quality</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <properties>
                <!-- measured 80.5% line / 67.0% branch on JDK 21, 82.0% / 69.3% on JDK 25; raise when
                     coverage rises, never lower -->
                <jacoco.runtime.minimum.line>0.80</jacoco.runtime.minimum.line>
                <jacoco.runtime.minimum.branch>0.66</jacoco.runtime.minimum.branch>
                <census.it.jacocoExec>${project.build.directory}/jacoco-it.exec</census.it.jacocoExec>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-child-jvms</id>
                                <goals>
                                    <goal>prepare-agent-integration</goal>
                                </goals>
                                <configuration>
                                    <propertyName>census.it.jacocoAgent</propertyName>
                                    <destFile>${census.it.jacocoExec}</destFile>
                                    <inclBootstrapClasses>true</inclBootstrapClasses>
                                    <includes>
                                        <include>com.developmentsprint.cryptocensus.agent.*</include>
                                    </includes>
                                    <excludes>
                                        <exclude>com.developmentsprint.cryptocensus.agent.shaded.*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- unit gate: only classes designed for unit tests (see jacoco.minimum.* above) -->
                                <id>jacoco-check</id>
                                <configuration>
                                    <excludes>
                                        <exclude>**/Installer.class</exclude>
                                        <exclude>**/Installer$*.class</exclude>
                                        <exclude>**/Advices.class</exclude>
                                        <exclude>**/Advices$*.class</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <census.it.jacocoAgent>${census.it.jacocoAgent}</census.it.jacocoAgent>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <!-- the JaCoCo agent appends, so stale data from an earlier build must go first -->
                                <id>jacoco-runtime-reset</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete file="${census.it.jacocoExec}" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-runtime-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <ant antfile="${project.basedir}/src/build/runtime-coverage.xml" target="check" inheritAll="false" inheritRefs="true">
                                            <property name="it.exec" value="${census.it.jacocoExec}"/>
                                            <property name="unit.exec" value="${project.build.directory}/jacoco.exec"/>
                                            <property name="agent.jar" value="${project.build.directory}/${project.build.finalName}.jar"/>
                                            <property name="source.dir" value="${project.build.sourceDirectory}"/>
                                            <property name="report.dir" value="${project.reporting.outputDirectory}/jacoco-runtime"/>
                                            <property name="minimum.line" value="${jacoco.runtime.minimum.line}"/>
                                            <property name="minimum.branch" value="${jacoco.runtime.minimum.branch}"/>
                                            <property name="skip.tests" value="${skipTests}"/>
                                            <property name="skip.its" value="${skipITs}"/>
                                            <property name="skip.test.compile" value="${maven.test.skip}"/>
                                            <property name="skip.jacoco" value="${jacoco.skip}"/>
                                        </ant>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
