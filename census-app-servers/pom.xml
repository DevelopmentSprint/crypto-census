<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.developmentsprint</groupId>
        <artifactId>census-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>census-app-servers</artifactId>
    <name>Crypto Census :: App Server Conformance</name>
    <description>
        Conformance tests that run the agent inside real application servers (Open Liberty on IBM Semeru,
        WildFly) in containers. Part of the build only with -P app-servers; skipped without Docker.
        Not published.
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <census.requireDocker>false</census.requireDocker>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.developmentsprint</groupId>
            <artifactId>census-annotations</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- built first in the reactor; copied to target/it-agents, never on the test class path -->
            <groupId>com.developmentsprint</groupId>
            <artifactId>census-agent</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.developmentsprint</groupId>
            <artifactId>census-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- compiles the servlet packaged into the test WAR; the servers provide the API -->
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet-api.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-agent</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>census-agent</includeArtifactIds>
                            <stripVersion>true</stripVersion>
                            <outputDirectory>${project.build.directory}/it-agents</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>com.developmentsprint:census-agent</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <systemPropertyVariables>
                        <census.agent.jar>${project.build.directory}/it-agents/census-agent.jar</census.agent.jar>
                        <!-- CI sets true: missing Docker then fails the conformance gate instead of skipping it -->
                        <census.requireDocker>${census.requireDocker}</census.requireDocker>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
