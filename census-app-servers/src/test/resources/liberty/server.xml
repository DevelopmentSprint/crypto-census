<?xml version="1.0" encoding="UTF-8"?>
<!-- Open Liberty configuration for AppServerIT: plain HTTP, the servlet feature, apps from dropins. -->
<server description="crypto-census conformance">
    <featureManager>
        <feature>servlet-6.0</feature>
    </featureManager>
    <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" httpsPort="-1"/>
    <applicationMonitor dropinsEnabled="true" updateTrigger="disabled"/>
</server>
