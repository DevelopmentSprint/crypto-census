<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.developmentsprint</groupId>
    <artifactId>census-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>Crypto Census</name>
    <description>
        Runtime cryptographic inventory for the JVM. A -javaagent that records the cryptography your
        application actually uses and emits a CycloneDX CBOM with post-quantum readiness findings.
    </description>
    <url>https://github.com/DevelopmentSprint/crypto-census</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Development Sprint, LLC</name>
        <url>https://developmentsprint.com</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>torr</id>
            <name>Todd Orr</name>
            <email>todd@developmentsprint.com</email>
            <organization>Development Sprint, LLC</organization>
            <organizationUrl>https://developmentsprint.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/DevelopmentSprint/crypto-census</url>
        <connection>scm:git:https://github.com/DevelopmentSprint/crypto-census.git</connection>
        <developerConnection>scm:git:git@github.com:DevelopmentSprint/crypto-census.git</developerConnection>
        <tag>v0.1.0</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/DevelopmentSprint/crypto-census/issues</url>
    </issueManagement>

    <modules>
        <module>census-core</module>
        <module>census-agent</module>
        <module>census-delivery</module>
        <module>census-cli</module>
        <module>census-maven-plugin</module>
        <module>census-demo</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <bytebuddy.version>1.18.14</bytebuddy.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <maven.api.version>3.9.16</maven.api.version>
        <maven.plugin.tools.version>3.16.0</maven.plugin.tools.version>

        <!-- conformance tests (test scope only; see docs/CONFORMANCE.md) -->
        <tomcat.version>11.0.26</tomcat.version>
        <opentelemetry-javaagent.version>2.31.1</opentelemetry-javaagent.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <jakarta.servlet-api.version>6.0.0</jakarta.servlet-api.version>

        <!-- static analysis: see the "quality" profile -->
        <spotless.version>3.10.4</spotless.version>
        <google-java-format.version>1.36.1</google-java-format.version>
        <checkstyle.version>14.3.0</checkstyle.version>
        <pmd.version>7.28.0</pmd.version>
        <spotbugs.version>4.10.5</spotbugs.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <errorprone.version>2.50.0</errorprone.version>
        <jacoco.version>0.8.15</jacoco.version>
        <dependency-check.version>13.0.0</dependency-check.version>
        <quality.config.dir>${maven.multiModuleProjectDirectory}/config</quality.config.dir>
        <!-- coverage floors, set per module from measured values: they may only go up -->
        <jacoco.minimum.line>0.00</jacoco.minimum.line>
        <jacoco.minimum.branch>0.00</jacoco.minimum.branch>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.17</version>
            </dependency>
            <!-- Override older validator transitives with the patched Jackson release family. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.22.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.developmentsprint</groupId>
                <artifactId>census-delivery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.developmentsprint</groupId>
                <artifactId>census-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.developmentsprint</groupId>
                <artifactId>census-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${bytebuddy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
