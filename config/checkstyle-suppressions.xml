<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
    Checkstyle runs Google's own google_checks.xml unmodified. Suppressions here must be narrow and
    explained.
-->
<suppressions>
    <!-- Generated by maven-plugin-plugin (HelpMojo); not our source. -->
    <suppress checks=".*" files="[\\/]generated-sources[\\/]"/>
    <!-- Test methods document themselves through their names; Javadoc there is noise. -->
    <suppress checks="MissingJavadoc(Method|Type)|JavadocParagraph|SummaryJavadoc" files="[\\/]src[\\/]test[\\/]"/>
    <!-- *IT is Maven Failsafe's naming convention for integration tests. -->
    <suppress checks="AbbreviationAsWordInName" files="IT\.java$"/>
</suppressions>
