<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
    Checkstyle runs Google's own google_checks.xml unmodified. Suppressions here must be narrow and
    explained.
-->
<suppressions>
    <!-- HelpMojo, generated by maven-plugin-plugin; not our source. The build's own check runs at
         validate, before it exists, but any later run (checkstyle:check after generate-sources, an
         IDE) scans the generated-sources root too. -->
    <suppress checks=".*" files="[\\/]generated-sources[\\/]"/>
    <!-- Test code is not API: public entry points there (e.g. CryptoWorkload.main, the child-JVM
         workload) and test classes need no Javadoc. Javadoc that is written is still checked. -->
    <suppress checks="MissingJavadoc(Method|Type)" files="[\\/]src[\\/]test[\\/]"/>
    <!-- *IT is Maven Failsafe's naming convention for integration tests (AgentIT). -->
    <suppress checks="AbbreviationAsWordInName" files="IT\.java$"/>
</suppressions>
