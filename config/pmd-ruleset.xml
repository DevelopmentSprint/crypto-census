<?xml version="1.0"?>
<ruleset name="crypto-census"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>
        PMD's curated quickstart set, plus the full security, multithreading and error-prone
        categories. Every exclusion below says why, naming the code it covers; prefer fixing code
        over adding one, and re-check the rationale when that code changes.
    </description>

    <rule ref="rulesets/java/quickstart.xml">
        <!-- Also part of quickstart; see the multithreading reference below for the reason. -->
        <exclude name="AvoidUsingVolatile"/>
        <!-- Targets hot-path logging. Ours is the Maven plugins' Log: CheckMojo and PrepareAgentMojo
             call it a handful of times per build, so an isXxxEnabled() guard saves nothing. -->
        <exclude name="GuardLogStatement"/>
    </rule>
    <rule ref="category/java/security.xml"/>

    <rule ref="category/java/multithreading.xml">
        <!-- Flags every HashMap/LinkedHashMap/EnumMap. Each remaining one is created inside a method,
             filled by the thread that created it, then returned, serialized or wrapped unmodifiable
             (mostly CycloneDX JSON objects in Cbom, Json and CheckMojo); none is a mutable field.
             Shared mutable state uses ConcurrentHashMap or atomics (Inventory, Recorder, Installer),
             and static lookup tables are immutable Map.of/Map.ofEntries (Names, Policy, KeyInfo). -->
        <exclude name="UseConcurrentHashMap"/>
        <!-- J2EE-era rule: the agent must register a JVM shutdown hook (Installer), which is a
             Thread. -->
        <exclude name="DoNotUseThreads"/>
        <!-- Recorder's three volatile fields are deliberate: the enabled flag is half of the
             shutdown admission protocol (see Recorder.enter), the inventory reference is replaced by
             configure() (Installer calls it before enable()), and the test hook is read on that same path.
             Locks there would sit inside every instrumented JCA call. -->
        <exclude name="AvoidUsingVolatile"/>
        <!-- CensusAgent.start is the only synchronized method: a one-time-init guard against a
             repeated -javaagent / attach, where method-level locking is the clearest form. -->
        <exclude name="AvoidSynchronizedAtMethodLevel"/>
    </rule>

    <rule ref="category/java/errorprone.xml">
        <!-- Hits are CycloneDX field names in Cbom ("name", "type", "components", ...) and JCA
             algorithm names in Policy ("RSA", "DSA", "AES"); each reads better inline than as a
             constant that only restates its value. -->
        <exclude name="AvoidDuplicateLiterals"/>
        <!-- Numeric policy thresholds are named constants (Policy's MIN_*_BITS) or switch cases, and
             PMD already ignores 0 and -1. The remaining hits are JCA algorithm, mode and padding
             names compared in Policy, Cbom and KeyInfo ("RSA", "ECB", "NOPADDING", ...), option
             keywords ("true", "false"), CycloneDX property keys and a key=value arity check (2) in
             Cbom's parser, JSON syntax characters and the 0x20 control-character bound in Json, the
             '%' escape marker in Escapes, Recorder's outermost-call depth (1) and the
             javax.crypto.KEM class name. Constants would only restate those values. -->
        <exclude name="AvoidLiteralsInIfCondition"/>
        <!-- null means "absent" in the data model: Occurrence's compact constructor normalizes blank
             symbol/via to null, and Policy uses a null partial verdict for "no objection" (worst()
             ignores it). -->
        <exclude name="NullAssignment"/>
        <!-- Record-style accessors: a private field read through a method of the same name
             (Risk.severity(), Inventory.overflowedSites(), Recorder.inventory() and failures()). -->
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <!-- J2EE-era rule: Callsites and KeyInfo inspect a class's *defining* loader on purpose (is it
             a JDK class?); the thread context loader would answer a different question. -->
        <exclude name="UseProperClassLoader"/>
    </rule>

    <!-- Allow the read loop `while ((n = in.read(buffer)) > 0)` (Cbom's size-capped file read) and
         increments/decrements inside an operand (`++values > MAX_VALUES`, `charAt(pos++)` in Json's
         parser, `return ++depth[0]` in Recorder), nothing else. -->
    <rule ref="category/java/errorprone.xml/AssignmentInOperand">
        <properties>
            <property name="allowWhile" value="true"/>
            <property name="allowIncrementDecrement" value="true"/>
        </properties>
    </rule>
</ruleset>
